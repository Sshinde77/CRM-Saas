<?xml version="1.0" encoding="utf-8"?>
<!--
  Enforce HTTPS for all network traffic.
  Cleartext (HTTP) is blocked on all domains.
  Debug overrides are intentionally omitted so the security policy applies
  equally in both debug and release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
